# Copy to .env.local and adjust as needed. .env.local is gitignored.

# Local Supabase stack (via `npm run db:start`) — port 54422, not the
# Supabase CLI's usual 54322 default, because this machine already runs
# other local Supabase projects on the default port range (see
# supabase/config.toml). Run `supabase status` to confirm the actual
# port. When this points at a hosted Supabase project instead, use its
# connection string; DATABASE_URL_ADMIN should stay a direct (non-pooled)
# connection with rights to create/drop databases, since it's only used
# to create/reset the throwaway mktrading_test database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:54422/postgres
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:54422/mktrading_test

# Set to "true" only if DATABASE_URL points at a connection-pooled
# endpoint (e.g. a hosted Supabase project's pooled/Supavisor
# transaction-mode port, 6543) — those don't support prepared statements,
# which postgres.js uses by default. Leave false for a direct connection
# (the local stack above, or a hosted project's direct port).
DATABASE_DISABLE_PREPARE=false

# AES-256-GCM key used to encrypt TOTP secrets at rest. Generate with:
#   openssl rand -base64 32
# Required in production; in development an insecure fixed key is used
# automatically (with a loud warning) if this is left blank.
MFA_ENCRYPTION_KEY=

# Keys the HMAC jitter term in the synthetic trading price engine
# (lib/trading/price-engine.ts). Must stay secret — a client that could
# derive this could predict trade outcomes. Generate with:
#   openssl rand -base64 32
# Required in production; in development an insecure fixed value is used
# automatically (with a loud warning) if this is left blank. Never rotate
# this while any trade could still be open (max 300s window) — doing so
# would make a trade's settlement price computed under a different secret
# than its entry price was.
PRICE_ENGINE_SECRET=

# Shared-secret header auth for the internal settle-due-trades endpoint
# (app/api/trading/internal/settle-due/route.ts) — not session auth, since
# nothing calls this yet (built ahead of a real cron/scheduler existing).
# Generate with: openssl rand -base64 32
SETTLE_DUE_SECRET=

# "dev" simulates the M-Pesa STK-push flow (logs to console, always
# "succeeds") instead of calling the real Safaricom Daraja API. Swap for a
# real provider once credentials exist — see lib/mpesa/provider.ts for
# what that actually requires (a webhook, not just credentials).
MPESA_PROVIDER=dev

# How long the dev M-Pesa provider simulates waiting for the customer to
# approve the STK-push prompt before a deposit auto-confirms. Dev/testing
# convenience only — not used by any test (tests force the delay into the
# past directly rather than depending on this).
MPESA_DEV_CONFIRM_DELAY_SECONDS=15

# "dev" logs outgoing emails to the console and the /dev/inbox page instead
# of sending anything real. Swap for a real provider once credentials exist.
EMAIL_PROVIDER=dev

# "dev" always passes verification. Swap for a real provider (hCaptcha,
# Turnstile, ...) once credentials exist.
CAPTCHA_PROVIDER=dev

# Number of trusted reverse-proxy hops in front of this app. 0 = trust only
# the direct connection (correct default for local dev / no proxy). Only
# raise this if you know exactly how many proxies sit in front of the app,
# and read X-Forwarded-For from the right (proxy-appended) end, never trust
# the client-supplied left end.
TRUSTED_PROXY_HOP_COUNT=0
